# ==============================================================================
# SynergyTech Solutions: B2B Cold Outreach & Acquisition Engine
# Environment Configuration Template
# ==============================================================================

# Supabase (Database & Realtime)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Google Gemini API (For AI Teardowns & Outreach Hooks)
GEMINI_API_KEY=your_gemini_api_key

# Google PageSpeed Insights API (Optional)
PAGESPEED_API_KEY=your_pagespeed_api_key

# Google Workspace / Custom SMTP Settings
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@domain.com
SMTP_PASS=your_email_app_password
EMAIL_FROM="Moses Martin <mosesmartin@synergytechsol.com>"

# Vercel Cron Security
CRON_SECRET=your_cron_secret_token

# Application Base URL (Used for demo prototype links in cold emails & customer previews)
NEXT_PUBLIC_APP_URL=https://outreach.synergytechsol.com

# Apify Lead Discovery Engine (Google Maps & Apollo Actors)
APIFY_API_TOKEN=your_apify_api_token
